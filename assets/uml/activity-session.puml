@startuml
title Диаграмма деятельности фокус-сессии
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
start
:Выбрать активную задачу;
if (Настройки корректны?) then (да)
  :Запустить фокус-сессию;
else (нет)
  :Показать сообщение о неверных настройках;
  stop
endif
:Ввести длительности фаз Pomodoro;
if (Настройки верны?) then (да)
  :Сохранить настройки;
else (нет)
  :Показать ошибки настроек;
  stop
endif
if (Нужна пауза?) then (да)
  :Приостановить сессию;
endif
:Продолжить фокус-сессию;
:Завершить рабочую фазу;
if (Есть следующий интервал?) then (да)
  :Начать следующий интервал;
endif
stop
@enduml
